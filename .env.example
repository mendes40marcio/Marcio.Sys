# Copie para .env (local) ou configure no painel do Railway

# Gere uma chave segura com: openssl rand -hex 32
SECRET_KEY=troque-esta-chave-em-producao

# No Railway, adicione um PostgreSQL e ele injeta DATABASE_URL automaticamente.
# Local usa SQLite por padrao (nao precisa definir).
# DATABASE_URL=postgresql://user:senha@host:5432/banco

# Token do GitHub (opcional, evita rate limit 403)
# Crie em: https://github.com/settings/tokens (escopo: public_repo)
GITHUB_TOKEN=
GITHUB_USERNAME=mendes40marcio

# Origens permitidas (front-end)
FRONTEND_ORIGINS=https://mendes40marcio.github.io,http://localhost:3000,http://127.0.0.1:5500
